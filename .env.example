# Réglages de MAKAHO. Copier ce fichier en .env, jamais suivi par git,
# et compléter.

# Adresse de card-api, la seule source des chiffres : l'adresse publique,
# ou une adresse locale si MAKAHO tourne sur la même machine.
MAKAHO_CARD_API_URL=https://card-api.riverly.inrae.fr

# Jeton de la clé de priorité MAKAHO, envoyé en en-tête X-API-Key.
# Il se demande par courriel (README de card-api) et ne s'écrit nulle part
# ailleurs que dans .env.
MAKAHO_CARD_API_KEY=
